    </Overwrite>
    <Overwrite uuid="3234edf8-ee57-41f1-92b0-d94cb0dcb32c">
      <enabled>1</enabled>
      <servers>83ae6bc8-f836-4f39-85d9-37c42eb537ad</servers>
      <common_name>btunde</common_name>
      <push_reset>1</push_reset>
      <local_networks>192.168.40.0/24,192.168.226.0/24</local_networks>
      <description>OFFICE csoport - Office csoport tagja - atmeneti (226/24) + vegleges (40/24) halo</description>
    </Overwrite>
    </StaticClients>
  </OpenVPN>
</opnsense>
