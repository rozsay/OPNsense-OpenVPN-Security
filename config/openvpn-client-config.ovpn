# OpenVPN Client Configuration - Maximum Security
# Version: 1.0.0
# Date: 2026-09-03
# Description: Enterprise-grade OpenVPN client config with TLS 1.3, AES-256-GCM, mTLS

# ===== CLIENT MODE =====
client
dev tun
proto udp

# ===== SERVER CONNECTION =====
# Replace with your actual server hostname/IP
remote vpn.yourdomain.com 1194
remote-random
remote-random-hostname

# ===== CONNECTION SETTINGS =====
resolv-retry infinite
nobind
persist-key
persist-tun

# ===== MAXIMUM SECURITY ENCRYPTION =====
# Cipher Suite (MUST match server)
cipher AES-256-GCM
ncp-ciphers AES-256-GCM:AES-128-GCM

# HMAC Authentication
auth SHA256

# ===== TLS 1.3 MANDATORY =====
tls-version 1.3
tls-ciphers TLS_AES_256_GCM_SHA384
tls-ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256

# ===== KEY EXCHANGE & SECURITY =====
# Elliptic Curve Diffie-Hellman
ecdh-curve secp384r1

# Perfect Forward Secrecy
key-direction 1

# Remote Certificate Validation (mTLS)
remote-cert-tls server
verify-x509-name server name

# ===== KEEPALIVE & RECONNECTION =====
keepalive 10 120
connect-retry 3 5
connect-retry-max 10
explicit-exit-notify 1

# ===== COMPRESSION DISABLED (SECURITY) =====
comp-lzo no
disable-occ

# ===== ROUTING =====
# Push routes to local networks (if allowed by server)
route 192.168.226.0 255.255.255.0 vpn_gateway
route 192.168.20.0 255.255.255.0 vpn_gateway
route 192.168.30.0 255.255.255.0 vpn_gateway

# ===== DNS SETTINGS =====
# Use VPN DNS (push by server or manually set)
# dhcp-option DNS 192.168.226.3
# dhcp-option DOMAIN internal

# ===== LOGGING & VERBOSITY =====
verb 4
mute 20
log openvpn.log
status status.log 15

# ===== SCRIPT SECURITY =====
script-security 2
# up /etc/openvpn/up.sh
# down /etc/openvpn/down.sh

# ===== TIMEOUTS =====
# Inactive timeout
inactive 600 30
# auto-exit

# ===== PERFORMANCE TUNING =====
# TCP window size
sndbuf 524288
rcvbuf 524288

# ===== SECURITY HARDENING =====
# Disable replay protection exceptions
no-replay

# Require client certificate
client-cert-not-required

# ===== SSL/TLS SETTINGS =====
# Do NOT use insecure protocols
# min-tls-version 1.3

# Disable legacy algorithms
no-dco

# ===== INLINE CERTIFICATES & KEYS =====
# These must be base64 encoded or embedded

<ca>
-----BEGIN CERTIFICATE-----
# [PASTE YOUR CA CERTIFICATE HERE]
# Example format:
# MIIDfDCCAmSgAwIBAgIBADANBgkqhkiG9w0BAQsFADCBgDELMAkGA1UEBhMCVVMx
# ... (rest of certificate content)
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
# [PASTE YOUR CLIENT CERTIFICATE HERE]
# Example format:
# MIIDfDCCAmSgAwIBAgIBADANBgkqhkiG9w0BAQsFADCBgDELMAkGA1UEBhMCVVMx
# ... (rest of certificate content)
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
# [PASTE YOUR CLIENT PRIVATE KEY HERE - KEEP THIS SAFE!]
# Example format:
# MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCzx...
# ... (rest of key content)
-----END PRIVATE KEY-----
</key>

<tls-auth>
-----BEGIN OpenVPN Static key V1-----
# [PASTE YOUR TA KEY HERE]
# Format: 2048 hexadecimal values in specific format
# Example:
# 6c656420daea9ba0c8c9f7a91c...
# ... (rest of key content)
-----END OpenVPN Static key V1-----
</tls-auth>

# ===== CONNECTION RETRY =====
# Retry settings
retry-infinite
allow-pull-fqdn

# ===== ADVANCED OPTIONS =====
# Reduce CPU usage
fast-io

# Enable client-specific options
allow-recursive-routing

# ===== CERTIFICATE PINNING =====
# Verify server certificate subject
# verify-x509-name server name

# ===== FIREWALL PUNCH-THROUGH =====
# UDP socket flags (improves NAT traversal)
socket-flags TCP_NODELAY

# ===== CUSTOM ENVIRONMENT =====
setenv FORWARD_COMPATIBLE 1

# ===== DEPRECATED/REMOVED OPTIONS =====
# Do NOT use (removed in newer OpenVPN versions):
# - ncp-disable
# - cipher (removed in v2.5+)
# - auth-nocache

# ===== SECURITY NOTICE =====
# ⚠️ IMPORTANT SECURITY REMINDERS:
# 1. Never share this config file containing certificates/keys
# 2. Ensure file permissions: chmod 600 client.ovpn
# 3. Keep private key secure and never transmit insecurely
# 4. Verify server certificate validity regularly
# 5. Monitor connection logs for suspicious activity
# 6. Use strong, unique credentials for authentication

# ===== METADATA =====
# Config Version: 1.0.0
# Encryption: AES-256-GCM
# TLS Version: 1.3
# HMAC: SHA256
# Key Exchange: ECDH P-384
# Security Level: Maximum
# Recommended OS: Linux, macOS, Windows (with OpenVPN GUI)
# Tested with OpenVPN: 2.5.x, 2.6.x

# ===== END OF CONFIGURATION =====
