      <servers>83ae6bc8-f836-4f39-85d9-37c42eb537ad</servers>
      <common_name>lendvai</common_name>
      <push_reset>1</push_reset>
      <local_networks>192.168.30.0/24</local_networks>
      <description>DEV csoport - Fejlesztoi csoport tagja - csak VLAN30</description>
    </Overwrite>
    <Overwrite uuid="435be430-ded5-4a1f-9d8e-f154469ab168">
      <enabled>1</enabled>
      <servers>83ae6bc8-f836-4f39-85d9-37c42eb537ad</servers>
      <common_name>tkati</common_name>
      <push_reset>1</push_reset>
      <local_networks>192.168.40.0/24,192.168.226.0/24</local_networks>
