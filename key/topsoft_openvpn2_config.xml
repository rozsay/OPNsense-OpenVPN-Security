<?xml version="1.0"?>
<!--
  ============================================================================
  topsoft.hu - MASODIK OpenVPN szolgaltatas (UDP 1987) - RESZLEGES CONFIG
  Felhasznalo-csoportos route-kiosztassal (DEV -> VLAN30, OFFICE -> VLAN40+226/24)
  ============================================================================
  FONTOS - OLVASD EL ELOSZOR (ugyanaz a figyelmeztetes, mint az elso OpenVPN
  migracional - az OPNsense XML semaja verziofuggo, ELLENORIZD elesites elott):

  1. KOTELEZO KEZI KITOLTES ezen a fajlon, a GUI-s CA/cert import UTAN:
       <ca>CSERELD-KI-A-CA-REFID-RE</ca>
       <cert>CSERELD-KI-A-CERT-REFID-RE</cert>
       <tls_key>ILLESZD-BE-A-tls-crypt.key-TARTALMAT</tls_key>
       <authmode>ELLENORIZD-A-TOTP-AUTH-SZERVER-PONTOS-NEVET-A-GUI-N</authmode>
     (System -> Access -> Servers - a mar meglevo "Timebased One Time Password"
     bejegyzes pontos nevet masold ide, VAGY allitsd be a GUI-n kezzel az
     Instance letrehozasakor, es ezt a sort hagyd ki.)

  2. TUNNEL HALO: 10.9.0.0/24 - EZ SZANDEKOSAN KULONBOZIK a korabban migralt
     elso OpenVPN szolgaltatas 10.8.0.0/24-es halojatol, hogy ne utkozzenek.

  3. tls-version-min 1.2 es tls-cipher direktivak: nincs kulon XML mezo ra
     ebben a semaban - ha a GUI-n van "Advanced configuration" / custom
     options szabad szoveges mezo, oda kell beirni oket kulon.

  4. route 10.10.1.0/24 es route 10.8.2.0/24: az eredeti configban szerepelt
     direktivak, celjuk tisztazatlan - SZANDEKOSAN NEM migralva ide, csak
     akkor potold, ha kiderul hogy tenyleg kell valamelyik kliensnek.

  5. IMPORT MODJA (OPNsense GUI):
     System/Diagnostics -> Configuration -> Backups -> Upload ezt a fajlt ->
     "Restore area" -> valaszd az OpenVPN-hez tartozo opciot -> Restore
     configuration. NE valaszd az "All" / teljes visszaallitast!

  6. UJ FELHASZNALO HOZZAADASA: bovitsd a topsoft_openvpn2_users.csv-t egy uj
     sorral, majd futtasd ujra:
       python3 build_openvpn2_config.py topsoft_openvpn2_users.csv topsoft_openvpn2_config.xml
     Ez ujragneralja a TELJES fajlt (az Instance UUID-je es a mar meglevo
     felhasznalok CSO UUID-jei UJRAGENERALODNAK minden futtataskor - ha egy
     mar ELESITETT config.xml-hez akarsz csak EGY UJ felhasznalot hozzaadni
     anelkul hogy a tobbit ujraimportalnad, inkabb a GUI-n vidd fel kezzel az
     uj CSO-t, ugyanazzal a mintaval, mint a tobbi.)
  ============================================================================
-->
<opnsense>
  <OpenVPN>
    <Instances>
      <Instance uuid="83ae6bc8-f836-4f39-85d9-37c42eb537ad">
        <role>server</role>
        <dev_type>tun</dev_type>
        <protocol>UDPv4</protocol>
        <port>1987</port>
        <ca>CSERELD-KI-A-CA-REFID-RE</ca>
        <cert>CSERELD-KI-A-CERT-REFID-RE</cert>
        <tls_mode>crypt</tls_mode>
        <tls_key>ILLESZD-BE-A-tls-crypt.key-TARTALMAT</tls_key>
        <verify_client_cert>none</verify_client_cert>
        <username_as_common_name>1</username_as_common_name>
        <authmode>ELLENORIZD-A-TOTP-AUTH-SZERVER-PONTOS-NEVET-A-GUI-N</authmode>
        <digest>SHA512</digest>
        <data_ciphers>AES-256-GCM</data_ciphers>
        <topology>subnet</topology>
        <tunnel_network>10.9.0.0/24</tunnel_network>
        <local_network></local_network>
        <duplicate_cn>1</duplicate_cn>
        <various_flags>client-to-client,explicit-exit-notify</various_flags>
        <various_push_flags>explicit-exit-notify</various_push_flags>
        <keepalive_interval>10</keepalive_interval>
        <keepalive_timeout>120</keepalive_timeout>
        <dns_servers>192.168.226.3</dns_servers>
        <verbosity>3</verbosity>
        <description>topsoft VPN 2 - felhasznalo-csoportos (DEV/OFFICE), UDP 1987, PAM+OTP</description>
      </Instance>
    </Instances>
    <StaticClients>
    <Overwrite uuid="5401a2a9-b668-4e31-9077-0db6ce4d2ab6">
      <enabled>1</enabled>
      <servers>83ae6bc8-f836-4f39-85d9-37c42eb537ad</servers>
      <common_name>rozsay</common_name>
      <push_reset>1</push_reset>
      <local_networks>192.168.30.0/24</local_networks>
      <description>DEV csoport - Fejlesztoi csoport tagja - csak VLAN30</description>
    </Overwrite>
