<?xml version="1.0"?>
<!-- OPNsense OpenVPN Server - Maximum Security Configuration -->
<!-- Version: 1.0.0 | Date: 2026-09-03 -->

<openvpn_server>
  <!-- Basic Server Settings -->
  <general>
    <enabled>1</enabled>
    <description>OpenVPN Server - Maximum Security (TLS 1.3, AES-256-GCM)</description>
    <protocol>UDP</protocol>
    <port>1194</port>
    <tunnel_network>10.8.0.0</tunnel_network>
    <local_network>192.168.226.0/24,192.168.20.0/24,192.168.30.0/24</local_network>
    <auth_mode>Local Database</auth_mode>
  </general>

  <!-- MAXIMUM SECURITY CRYPTOGRAPHY -->
  <crypto>
    <cipher>AES-256-GCM</cipher>
    <cipher_ncp_list>AES-256-GCM:AES-128-GCM</cipher_ncp_list>
    <auth>SHA256</auth>
    <tls_version>1.3</tls_version>
    <tls_ciphers>TLS_AES_256_GCM_SHA384</tls_ciphers>
    <tls_ciphersuites>TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256</tls_ciphersuites>
    <ecdh_curve>secp384r1</ecdh_curve>
    <dh_bits>4096</dh_bits>
    <pfs_enabled>1</pfs_enabled>
    <renegotiate_seconds>3600</renegotiate_seconds>
    <disable_compression>1</disable_compression>
  </crypto>

  <!-- SECURITY SETTINGS -->
  <security>
    <mtls_enabled>1</mtls_enabled>
    <cert_pinning_enabled>1</cert_pinning_enabled>
    <verify_x509_name>server</verify_x509_name>
    <crl_check>1</crl_check>
    <tls_auth_enabled>1</tls_auth_enabled>
  </security>

  <!-- KEEPALIVE AND RECONNECTION -->
  <keepalive>
    <keepalive_interval>10</keepalive_interval>
    <keepalive_timeout>120</keepalive_timeout>
    <connect_retry_interval>3</connect_retry_interval>
    <explicit_exit_notify>1</explicit_exit_notify>
  </keepalive>

  <!-- LOGGING -->
  <logging>
    <loglevel>4</loglevel>
    <logfile>/var/log/openvpn/openvpn.log</logfile>
    <syslog_enabled>1</syslog_enabled>
  </logging>

  <!-- CROWDSEC INTEGRATION -->
  <security_integration>
    <crowdsec_enabled>1</crowdsec_enabled>
    <log_to_crowdsec>1</log_to_crowdsec>
  </security_integration>
</openvpn_server>