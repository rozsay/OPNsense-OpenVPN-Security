port 1987
proto udp4
dev tun

ca ca.crt
cert server_gw.crt
key server_gw.key
#cert server_6753pNs2T8v6JiyO.crt
#key server_6753pNs2T8v6JiyO.key

dh  none
# dh dh1024.pem
# ecdh-curve prime256v1
#tls-auth ta.key 0 
tls-crypt tls-crypt.key 0
crl-verify crl.pem

auth SHA512
#cipher AES-128-GCM
cipher AES-256-CBC
data-ciphers AES-256-GCM

tls-server
tls-version-min 1.2
tls-cipher TLS-ECDHE-RSA-WITH-AES-128-GCM-SHA256

topology subnet
server 10.8.0.0 255.255.255.0
ifconfig-pool-persist ipp.txt
push "route 192.168.226.0 255.255.255.0"
duplicate-cn
route 10.10.1.0 255.255.255.0

# NEW
#push "redirect-gateway def1"
# iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o ppp0 -j MASQUERADE
push "dhcp-option DNS 10.8.0.1"
client-config-dir /etc/openvpn/ccd
#mode server
#push "topology subnet"
#ifconfig 10.8.0.1 255.255.255.0
#route 192.168.226.0 255.255.255.0 10.8.0.1
#push "route-gateway 10.8.0.1"
#ifconfig-pool 10.8.0.22 10.8.0.55 255.255.255.0
# to allow network traffic between client's subnet (10.8.0.0/24) and other clients of the OpenVPN server.
#If so, add the following to the server config file.
client-to-client

#Class          Virtual IP Range        Allowed LAN Access                      Common Names
#Employees      10.8.0.0/24             Samba/email server at 192.168.226.3     [variable]
#System Admins  10.8.1.0/24             Entire 192.168.226.0/24 subnet          sysadmin1
#Contractors    10.8.2.0/24             Contractor server at 192.168.226.15     contractor1, contracter2
#Add routes for the System Administrator and Contractor IP ranges:
#push route add 10.8.2.0/32
#route 10.8.1.0 255.255.255.0
route 10.8.2.0 255.255.255.0
#route 192.168.226.0 255.255.255.0

#Because we will be assigning fixed IP addresses for specific System Administrators and Contractors, we will use a client configuration directory:
#script-security 3
#client-connect /etc/openvpn/scripts/client_connect.sh
#client-disconnect /etc/openvpn/scripts/client-disconnect.sh

sndbuf 0
rcvbuf 0

# change country
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
# change country end

#comp-lzo
#route 192.168.65.0 255.255.255.0 10.8.0.1

keepalive 10 120
#keepalive 10 3000
#reneg-sec 0
#user nobody
#group nogroup
persist-key
persist-tun

status /var/log/openvpn-status.log
log-append /var/log/openvpn.log

verb 6

#daemon

#management 192.168.226.1 5555
#management 192.168.226.3 5555 /etc/openvpn/pwd.txt

# Notify the client that when the server restarts so it
# can automatically reconnect.
explicit-exit-notify 1

# PAM plugin
#plugin /usr/lib/openvpn/openvpn-auth-pam.so login
#plugin /usr/lib/x86_64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so login
#auth-user-pass-verify /usr/lib/openvpn/openvpn-auth-pam.so login via-env
#plugin /usr/lib/x86_64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so openvpn
plugin /usr/lib/x86_64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so "openvpn login USERNAME password PASSWORD pin OTP"
#verify-client-cert none
verify-client-cert none
#client-cert-not-required
username-as-common-name

# Notify the client that when the server restarts so it
# can automatically reconnect.
explicit-exit-notify 1

#user nobody
#group nogroup

